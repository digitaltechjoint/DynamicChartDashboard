@{
    ViewData["Title"] = "Dynamic Sales Analytics Dashboard";
}

<div class="dashboard-wrapper">
    <div class="text-center mb-4">
        <h1 class="dashboard-title">Dynamic Sales Analytics</h1>
        <p class="text-muted mb-0">Digital TechJoint (DTJ) — Filter sales data and switch chart types dynamically</p>
    </div>

    <!-- Alert for errors / no data -->
    <div id="alertBox" class="alert alert-danger d-none" role="alert"></div>

    <!-- Filters -->
    <div class="card filter-card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label for="yearSelect" class="form-label fw-semibold">Year</label>
                    <select id="yearSelect" class="form-select">
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026" selected>2026</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label for="monthSelect" class="form-label fw-semibold">Month</label>
                    <select id="monthSelect" class="form-select">
                        <option value="0" selected>All Months</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label for="chartTypeSelect" class="form-label fw-semibold">Chart Type</label>
                    <select id="chartTypeSelect" class="form-select">
                        <option value="bar" selected>Bar Chart</option>
                        <option value="line">Line Chart</option>
                        <option value="pie">Pie Chart</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" id="btnApply" class="btn btn-primary flex-grow-1">Apply Filters</button>
                        <button type="button" id="btnReset" class="btn btn-outline-secondary flex-grow-1">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card summary-card h-100">
                <div class="card-body">
                    <div class="summary-label">Total Sales</div>
                    <div id="totalSales" class="summary-value">₹0</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card summary-card h-100">
                <div class="card-body">
                    <div class="summary-label">Selected Year</div>
                    <div id="selectedYear" class="summary-value">2026</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card summary-card h-100">
                <div class="card-body">
                    <div class="summary-label">Selected Month</div>
                    <div id="selectedMonth" class="summary-value">All Months</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card summary-card h-100">
                <div class="card-body">
                    <div class="summary-label">Number of Months</div>
                    <div id="monthCount" class="summary-value">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="card chart-card">
        <div class="card-body">
            <h5 class="card-title mb-3">Sales Chart</h5>
            <div class="chart-container">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Chart.js library from CDN *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script>
        let salesChart;

        //format number 
         const currencyFormatter = new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: 'INR',
            maximumFractionDigits: 0
        });

        document.addEventListener('DOMContentLoaded', function () {
             document.getElementById('btnApply').addEventListener('click', loadChart);
             document.getElementById('btnReset').addEventListener('click', resetFilters);

             // Load chart with default filters (Year 2026, All Months, Bar)
             loadChart();
        });

         // Reset dropdowns to defaults, then reload the chart
        function resetFilters() {
            document.getElementById('yearSelect').value = '2026';
            document.getElementById('monthSelect').value = '0';      // 0 = All Months
            document.getElementById('chartTypeSelect').value = 'bar';
            loadChart();
        }

            // Show a message in the Bootstrap alert box
        function showAlert(message) {
            const alertBox = document.getElementById('alertBox');
            alertBox.textContent = message;
            alertBox.classList.remove('d-none');
        }

          // Hide the Bootstrap error/no-data alert
        function hideAlert() {
            const alertBox = document.getElementById('alertBox');
            alertBox.classList.add('d-none');
            alertBox.textContent = '';
        }
           // Read Year, Month, and Chart Type from the dropdowns
        function getSelectedFilters() {
            return {
                year: parseInt(document.getElementById('yearSelect').value, 10),
                month: parseInt(document.getElementById('monthSelect').value, 10),
                chartType: document.getElementById('chartTypeSelect').value
            };
        }

        function updateSummary(data, filters) {
            //
            let total = 0;
            for (let i = 0; i < data.length; i++) {
                total = total + Number(data[i].value);
            }

            // Get the visible month name from the dropdown (e.g. "March")
            const monthSelect = document.getElementById('monthSelect');
            const selectedMonthText = monthSelect.options[monthSelect.selectedIndex].text;

            // Write values into the summary card HTML elements
            document.getElementById('totalSales').textContent = currencyFormatter.format(total);
            document.getElementById('selectedYear').textContent = filters.year;
            document.getElementById('selectedMonth').textContent = selectedMonthText;
            document.getElementById('monthCount').textContent = data.length;
        }

        //call the MVC API 
        async function loadChart() {
            hideAlert();

            const filters = getSelectedFilters();
            const url = `/Dashboard/GetChartData?year=${filters.year}&month=${filters.month}`;

            try {
                // fetch() is a built-in browser method (not something we wrote)
                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error('API request failed');
                }

                
                const data = await response.json();

               
                if (!data || data.length === 0) {
                    showAlert('No data available for the selected period.');
                    updateSummary([], filters);

                   
                    if (salesChart) {
                        salesChart.destroy();
                        salesChart = null;
                    }
                    return;
                }
                updateSummary(data, filters);
                renderChart(data, filters.chartType);
            } catch (error) {
                console.error(error);
                showAlert('Unable to load chart data. Please try again.');

                if (salesChart) {
                    salesChart.destroy();
                    salesChart = null;
                }
            }
        }

         // =====================================================
        // Chart.js — create Bar / Line / Pie chart on the canvas
        // =====================================================
        function renderChart(data, chartType) {

            // data comes from API as: [{ label: "January", value: 125000 }, ...]
            // Chart.js needs two separate arrays:

            // 1) labels = month names shown on the chart (X-axis or pie slices)
            //    Example: ["January", "February", "March", ...]
            const labels = data.map(x => x.label);

            // 2) values = sales numbers for each label
            //    Example: [125000, 145000, 168000, ...]
            const values = data.map(x => x.value);

            // IMPORTANT:
            // If a chart already exists on the canvas, destroy it first.
            // Otherwise switching Bar → Line → Pie causes canvas errors.
            if (salesChart) {
                salesChart.destroy();
            }

            // Get the <canvas id="salesChart"> drawing context
            const ctx = document.getElementById('salesChart').getContext('2d');

            // Create a new Chart.js chart
            salesChart = new Chart(ctx, {

                // chartType comes from the dropdown: "bar", "line", or "pie"
                type: chartType,

                data: {
                    // Month names for the chart
                    labels: labels,

                    // One dataset = one series of numbers (our sales amounts)
                    datasets: [{
                        // Name shown in legend / tooltip
                        label: 'Sales Amount',

                        // The actual numbers to plot
                        data: values,

                        // Colors for bars / pie slices (one color per month)
                        backgroundColor: [
                            '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e',
                            '#e74a3b', '#858796', '#5a5c69', '#2e59d9',
                            '#17a673', '#2c9faf', '#dda20a', '#be2617'
                        ]
                    }]
                },

                options: {
                    // Chart resizes automatically on desktop/tablet/mobile
                    responsive: true,

                    // Let our CSS control the chart height (.chart-container)
                    maintainAspectRatio: false
                }
            });
        }


    </script>
}


